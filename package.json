{
  "name": "lonewolfyx",
  "type": "module",
  "version": "1.0.1",
  "packageManager": "pnpm@12.10.1",
  "description": "Hi, I am lonewolfyx, And You can call me OldDriver",
  "author": "lonewolfyx <olddrivero.king@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/lonewolfyx/lonewolfyx",
  "bugs": {
    "url": "https://github.com/lonewolfyx/lonewolfyx/issues"
  },
  "keywords": [],
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/cli.d.mts",
  "bin": {
    "lonewolfyx": "bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "pnpm build",
    "prepare": "simple-git-hooks"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "^0.2.2",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@types/node": "^25.9.9",
    "eslint": "^10.12.0",
    "lint-staged": "^17.6.0",
    "picocolors": "^1.1.1",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "tsdown-preset": "^1.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
